<div class="input-area">
  <input id="msg" placeholder="Enter a command for J.A.R.V.I.S...">
  <button id="send">SEND</button>
  <button id="mic-btn" aria-label="Activate voice input">🎙️</button>
  <button id="cam-btn" aria-label="Analyze image">📷</button>
  <button id="clear-btn" aria-label="Clear memory">🗑️</button>
  <input id="img-input" type="file" accept="image/*" capture="environment" style="display:none">
</div>
